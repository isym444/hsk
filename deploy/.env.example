# Copy to `.env` next to docker-compose.yml and fill in.
#
#   cp .env.example .env
#   chmod 600 .env
#
# `.env` holds the database password and, if you use the legacy shared secret,
# the JWT secret. It is git-ignored and must never be committed or pasted into a
# chat/issue.

# ---------------------------------------------------------------------------
# Database — Supabase
# ---------------------------------------------------------------------------
# Supabase Dashboard -> your project -> Connect -> "Session pooler".
#
# Use the SESSION pooler, not the direct connection: the direct host
# (db.<ref>.supabase.co) is IPv6-only on Supabase's free tier, and the pooler
# is the IPv4-reachable one. Session mode also supports everything this API
# does (the app additionally disables prepared statements, so the transaction
# pooler on port 6543 would work too).
#
# The pooler host cannot be guessed from the region — copy it from the Connect
# dialog. The username is `postgres.<project-ref>`, not `postgres`.
#
# Percent-encode reserved characters in the password (& # ? / space ...).
# Keep `?sslmode=require`.
HSK_DATABASE_URL=postgresql://postgres.PROJECT_REF:PASTE_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# ---------------------------------------------------------------------------
# Authentication — Supabase Auth
# ---------------------------------------------------------------------------
# Your project URL. Needs no trailing slash. This is what the API uses to fetch
# the public keys that verify access tokens (JWKS), and it must be the same
# project the frontend signs users in against.
HSK_SUPABASE_URL=https://PROJECT_REF.supabase.co

# The legacy JWT secret, from Dashboard -> Project Settings -> API -> JWT
# Settings.
#
# Set it as well as the URL: tokens signed with the newer asymmetric signing
# keys are verified against the project's public keys (no secret involved),
# while projects still on the legacy shared secret are verified with this. With
# both configured, either kind of token works and you never have to work out
# which system your project is on.
HSK_SUPABASE_JWT_SECRET=PASTE_LEGACY_JWT_SECRET

# Who may use the API. Comma-separated, case-insensitive.
#
# Accounts are created in the Supabase dashboard and sign-ups are off, so this
# is a second lock rather than the only one — but it is the one that fails safe:
# an account added to the project by mistake still cannot reach the API until
# its address is listed here.
HSK_ALLOWED_EMAILS=you@example.com

# ---------------------------------------------------------------------------
# CORS — the browser origins allowed to call this API
# ---------------------------------------------------------------------------
# Comma-separated, no trailing slashes, scheme included. The Render static
# site's URL (and any custom domain you add to it). Find the exact value on the
# Render service page, e.g. https://hsk4-practice.onrender.com
HSK_CORS_ORIGINS=https://hsk4-practice.onrender.com

# ---------------------------------------------------------------------------
# Traefik
# ---------------------------------------------------------------------------
# The Docker network Traefik shares with the services it routes. Delete this if
# you removed the `networks:` block from docker-compose.yml.
TRAEFIK_NETWORK=traefik

# ---------------------------------------------------------------------------
# Optional tuning
# ---------------------------------------------------------------------------
# Application-side connection pool. Supabase's free tier has a modest
# connection limit, so keep this small; 1-5 is right for a personal app.
HSK_DB_POOL_MIN=1
HSK_DB_POOL_MAX=5
